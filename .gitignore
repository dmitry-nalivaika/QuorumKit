# ── Local developer environment (produced by scripts/dev-setup.sh / init.sh) ─
# These are local working-environment outputs — not committed, regenerated by
# `bash scripts/dev-setup.sh`.  Everything else in .github/ IS tracked so that
# GitHub Actions, Dependabot, and issue templates work out of the box.
.claude/
.apm/
.apm-workspaces/
.copilot-agent-context.md
CLAUDE.md

# ── Copilot-mode-specific generated files (not used by QuorumKit's own CI) ───
# Generated by init.sh when --ai=copilot|both; gitignored because QuorumKit's
# canonical CI uses claude mode.  Consumer copilot-mode repos should commit these.
.github/agents/
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
.github/workflows/copilot-agent-*.yml

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Installed modules (like node_modules)
apm_modules/
engine/dashboard/node_modules/
engine/dashboard/.apm-project.json
engine/orchestrator/node_modules/
engine/node_modules/

engine/tests/.vite/
