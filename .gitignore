# ── Local developer environment only ─────────────────────────────────────────
# .claude/ is the local Claude Code context — not committed.
# Everything else in .github/ and .specify/ IS tracked.
.claude/
# agent-*.yml are Claude Code Action variants generated by init.sh --ai=claude.
# The committed runtime is copilot-agent-*.yml (GitHub Models). Do not commit both.
.github/workflows/agent-architect.yml
.github/workflows/agent-dev.yml
.github/workflows/agent-docs.yml
.github/workflows/agent-qa.yml
.github/workflows/agent-release.yml
.github/workflows/agent-reviewer.yml
.github/workflows/agent-security.yml
.github/workflows/agent-tech-debt.yml
.github/workflows/agent-triage.yml
# Industrial domain pack — claude variants (generated by --domain=industrial)
.github/workflows/agent-ot-integration.yml
.github/workflows/agent-digital-twin.yml
.github/workflows/agent-compliance.yml
.github/workflows/agent-incident.yml
# Industrial domain pack — copilot variants (generated by --domain=industrial)
# Universal copilot-agent-*.yml are committed; domain variants are not.
.github/workflows/copilot-agent-ot-integration.yml
.github/workflows/copilot-agent-digital-twin.yml
.github/workflows/copilot-agent-compliance.yml
.github/workflows/copilot-agent-incident.yml
.apm/
.apm-workspaces/
.copilot-agent-context.md
CLAUDE.md

# ── .specify/ dynamic metadata (timestamps written by specify init each run) ──
.specify/extensions/.registry
.specify/integrations/*.manifest.json
.specify/workflows/workflow-registry.json

