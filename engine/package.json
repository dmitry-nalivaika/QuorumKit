{
  "name": "quorumkit-engine",
  "version": "3.2.0",
  "description": "QuorumKit autonomous-agent orchestrator — distributed as a GitHub Action (Issue #47, ADR-047 amendment).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitry-nalivaika/QuorumKit.git"
  },
  "type": "module",
  "bin": {
    "quorumkit-engine": "bin/quorumkit-engine.js",
    "quorumkit-dashboard": "bin/quorumkit-dashboard.js"
  },
  "files": [
    "dist/",
    "action.yml",
    "RELEASING.md",
    "SECURITY.md",
    "dashboard/",
    "bin/"
  ],
  "scripts": {
    "build": "ncc build orchestrator/index.js -o dist --minify --source-map --license licenses.txt",
    "ncc:build": "npm run build",
    "test": "cd orchestrator && npm test",
    "ci:install": "npm ci --ignore-scripts && (cd orchestrator && npm ci --ignore-scripts) && (cd dashboard && npm ci --ignore-scripts)"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.44.1"
  }
}
